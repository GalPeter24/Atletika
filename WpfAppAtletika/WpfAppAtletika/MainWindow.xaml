<Window x:Class="WpfAppAtletika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppAtletika"
        mc:Ignorable="d"
        Title="Atlétikai verseny - Rajtszámok" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBox Text="Atlétikai verseny" FontSize="25" FontWeight="Bold"/>
            <TextBox Text="Versenyzők regisztrációja és rajtszámok kiosztása" Grid.Row="1"/>
        </Grid>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" CornerRadius="10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>
                    <RowDefinition  Height="auto"/>

                </Grid.RowDefinitions>
                <Label Content="Új Versenyző" FontWeight="Bold" FontSize="15"/>
                <Label Content="Versenyző neve:" Grid.Row="1"/>
                <TextBox VerticalAlignment="Stretch" Grid.Row="2"/>
                <Label Content="Versenyszám" Grid.Row="3"/>
                <ComboBox Grid.Row="4">
                    
                </ComboBox>
                <WrapPanel Grid.Row="5" HorizontalAlignment="Stretch">
                    <Label Content="Nem:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton Content="Férfi" VerticalAlignment="Center" Margin="20,0,30,0"/>
                    <RadioButton Content="Nő" VerticalAlignment="Center" Margin="30,0"/>
                </WrapPanel>
                <Grid Grid.Row="6" HorizontalAlignment="Stretch">
                    <Label Content="Életkor" HorizontalAlignment="Left"/>
                    <Label Content="év" HorizontalAlignment="Right" Foreground="Blue" FontWeight="Bold"/>
                </Grid>
                <Grid Grid.Row="7">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Slider Minimum="18" Maximum="90" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <Label/>
                </Grid>
                
            </Grid>
        </Border>

    </Grid>
</Window>
